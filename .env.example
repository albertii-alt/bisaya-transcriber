# Gemini API Key: Required for server-side Gemini Files API & generateContent calls
GEMINI_API_KEY="your_gemini_api_key_here"

# App Passcode: Required to secure your /api routes and prevent unauthorized usage
APP_PASSCODE="your_chosen_secret_passcode"

# Gemini Model: Model used for audio transcription (default: gemini-3.5-transcribe)
GEMINI_MODEL="gemini-3.5-transcribe"

# Chunk Minutes: Duration in minutes for each audio chunk slice (default: 6)
CHUNK_MINUTES="6"

